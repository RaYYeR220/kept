# YouCam API key (https://yce.perfectcorp.com/ai-api → API Keys)
YOUCAM_API_KEY=
# Hard cap on YouCam units this deployment may spend (live mode)
KEPT_UNIT_CAP=600
# Units one browser session may spend in live mode
KEPT_SESSION_UNIT_CAP=40
# OpenAI-compatible LLM endpoint for the Companion (Venice by default)
LLM_BASE_URL=https://api.venice.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# 32-byte base64 key used to encrypt shared photos at rest
SHARE_ENCRYPTION_KEY=
